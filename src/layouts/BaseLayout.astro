---
import { Font } from "astro:assets";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import avatar from "@assets/avatar.jpg";
import themeInit from "@lib/theme-init.js?raw";
import "@styles/global.css";

interface Props {
  /** Omit on the homepage — the site name alone is the title there. */
  title?: string;
  description: string;
  ogType?: "website" | "article";
  /** Set to "zh" on a page whose main content is Chinese. */
  lang?: "en" | "zh";
}

const { title, description, ogType = "website", lang = "en" } = Astro.props;

const pageTitle = title ? `${title} — Xinqi Mu` : "Xinqi Mu";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(avatar.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Paints the mobile browser chrome to match --ground in each theme. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FBFBFC" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101214" />

    {/* Synchronous, and before the stylesheet, so the theme never flashes.
        Its source is src/lib/theme-init.js, which astro.config.mjs also reads to
        derive the CSP hash — see the note there. */}
    <script is:inline set:html={themeInit} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Xinqi Mu" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="muxinqi — Notes"
      href="/notes/feed.xml"
    />

    {/* Upright only: italics are never on the first screen, and mono is small
        enough that its fallback swap is not worth a blocking request. */}
    <Font cssVariable="--font-newsreader" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-plex-sans" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-plex-mono" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="skip-link sr-only font-mono text-meta uppercase focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-ground focus:p-2"
      >Skip to content</a
    >

    <div
      class="mx-auto flex w-full max-w-frame flex-1 flex-col px-[clamp(1.25rem,5vw,2.5rem)] pt-4 pb-[clamp(2.5rem,8vw,4.5rem)]"
    >
      <SiteHeader />
      <main id="main" class="flex-1"><slot /></main>
      <SiteFooter />
    </div>
  </body>
</html>
