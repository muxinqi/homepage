---
import ThemeToggle from "@components/ThemeToggle.astro";
import GithubMark from "@assets/icons/github.svg";
import { localePath, type Locale } from "@i18n/locales";
import { useTranslations } from "@i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
const menu = localePath(lang, "/menu/");
const isHome = Astro.url.pathname === home;
const isMenu = Astro.url.pathname === menu;

// The theme control lives down here on purpose: it is a display preference, the
// system value is usually already right, and it has no business in the header.
//
// Icons sit beside the labels rather than replacing them. At 12px they are what
// the eye lands on first; the word is what removes the ambiguity an icon alone
// would leave — especially for a control with three states.
//
// The menu is linked from here and from About, not from the header: it is a
// side door, and the main nav stays about the work.
---

<footer
  class="mt-10 flex flex-wrap items-center justify-between gap-x-5 gap-y-3 border-t border-line pt-[13px] font-mono text-meta text-ink-muted uppercase"
>
  {/* Same rule as the header: no live link to the page you are already on. */}
  {
    isHome ? (
      <span aria-current="page">muxinqi</span>
    ) : (
      <a href={home} class="meta-link hover:text-ink">
        muxinqi
      </a>
    )
  }

  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    {
      isMenu ? (
        <span aria-current="page" class="text-ink">{t("menu")}</span>
      ) : (
        <a href={menu} class="meta-link hover:text-ink">
          {t("menu")}
        </a>
      )
    }

    <a
      href="https://github.com/muxinqi"
      class="meta-link inline-flex items-center gap-1.5 hover:text-ink"
      rel="me noopener noreferrer"
      target="_blank"
    >
      <GithubMark width="12" height="12" aria-hidden="true" />
      GitHub ↗
    </a>

    <ThemeToggle {lang} />
  </div>
</footer>
