---
import type { CollectionEntry } from "astro:content";
import { statusLabels } from "@lib/content";

interface Props {
  status: CollectionEntry<"projects">["data"]["status"];
}

const { status } = Astro.props;

/** 只有真正还在动的项目用强调色，其余一律中性——不把停掉的东西说成活的。 */
const isLive = status === "active" || status === "shipped";
---

<span
  class:list={[
    "inline-block rounded border px-1.5 py-0.5 font-mono text-xs",
    isLive ? "border-accent/40 text-accent" : "border-line text-faint",
  ]}
>
  {statusLabels[status]}
</span>
