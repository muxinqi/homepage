---
import Monitor from "@assets/icons/monitor.svg";
import Sun from "@assets/icons/sun.svg";
import Moon from "@assets/icons/moon.svg";

// Three states, not two: System → Light → Dark. With only two, a reader who
// clicks once can never get back to following the OS. Returning to System is
// `localStorage.removeItem`, and the anti-flash script in <head> reads the same
// key synchronously.
//
// All three icons are rendered and CSS shows the one matching `data-theme`, so
// switching never touches innerHTML. The visible word is the current *value*;
// the control's own name lives in the screen-reader-only "Theme:" prefix and in
// the tooltip, because "System" on its own says nothing about what it controls.
---

<noscript><style>[data-theme-toggle] { display: none; }</style></noscript>

<button
  type="button"
  data-theme-toggle
  data-theme="system"
  title="Switch colour theme — System, Light, Dark"
  class="meta-link inline-flex cursor-pointer items-center gap-1.5 uppercase hover:text-ink"
>
  <span data-icon="system" aria-hidden="true"><Monitor width="12" height="12" /></span>
  <span data-icon="light" aria-hidden="true"><Sun width="12" height="12" /></span>
  <span data-icon="dark" aria-hidden="true"><Moon width="12" height="12" /></span>
  <span class="sr-only">Theme:</span>
  <span data-theme-label>System</span>
</button>

<script>
  const ORDER = ["system", "light", "dark"] as const;
  type Theme = (typeof ORDER)[number];

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = document.querySelector<HTMLElement>("[data-theme-label]");

  function read(): Theme {
    try {
      const stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "dark") return stored;
    } catch {
      // Private mode, or site data blocked. Following the system is the right
      // answer in both cases.
    }
    return "system";
  }

  function apply(theme: Theme) {
    root.classList.remove("light", "dark");
    if (theme !== "system") root.classList.add(theme);
    if (button) button.dataset.theme = theme;
    if (label) label.textContent = theme[0].toUpperCase() + theme.slice(1);
  }

  function store(theme: Theme) {
    try {
      if (theme === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", theme);
    } catch {
      // Preference simply does not persist. The page still renders correctly.
    }
  }

  apply(read());

  button?.addEventListener("click", () => {
    const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length];
    store(next);
    apply(next);
  });
</script>
