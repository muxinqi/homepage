---
import type { CollectionEntry } from "astro:content";
import { formatMonth, isoDate } from "@lib/date";

interface Props {
  post: CollectionEntry<"posts">;
  /** 首页只要标题和日期，列表页多给一行摘要。 */
  showSummary?: boolean;
}

const { post, showSummary = false } = Astro.props;
const { title, summary, created, draft } = post.data;
---

<article>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-base font-medium">
      <a href={`/posts/${post.id}/`} class="hover:text-accent">{title}</a>
      {draft && <span class="ml-2 font-mono text-xs text-faint">草稿</span>}
    </h3>
    <time datetime={isoDate(created)} class="font-mono text-xs text-faint">{formatMonth(created)}</time>
  </div>
  {showSummary && <p class="mt-1 text-sm leading-relaxed text-muted">{summary}</p>}
</article>
