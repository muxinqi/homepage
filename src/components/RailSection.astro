---
interface Props {
  /** Doubles as the section heading, which is why inner pages need no h2. */
  label: string;
  /** Second line in the rail: the section's exit, or a timestamp. */
  note?: string;
  noteHref?: string;
  /** Every section's exit reads "All →"; this is what tells them apart in a
      screen reader's list of links. */
  noteLabel?: string;
  /**
   * Renders the note as a `<time>` and lets a script rewrite it as "2 months
   * ago" once it loads. Without JavaScript the absolute month stands, which is
   * why the server renders that and not a placeholder.
   */
  noteDatetime?: Date;
  /** Kept in front of the relative form: "Updated 2 months ago". */
  notePrefix?: string;
  /** Rows sitting under a top border need the label pushed down to meet them. */
  alignToList?: boolean;
  class?: string;
}

import { isoDate } from "@lib/date";

const {
  label,
  note,
  noteHref,
  noteLabel,
  noteDatetime,
  notePrefix,
  alignToList = true,
  class: className,
} = Astro.props;
const headingId = `section-${label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<section class:list={["rail-row", className]} aria-labelledby={headingId}>
  <div
    class:list={[
      "rail font-mono text-rail leading-[1.9] text-ink-muted",
      alignToList ? "pt-[15px]" : "pt-[3px]",
    ]}
  >
    <h2 id={headingId} class="font-medium uppercase">{label}</h2>
    {
      note &&
        (noteHref ? (
          <a
            href={noteHref}
            aria-label={noteLabel}
            class="meta-link inline-block tracking-[0.02em] text-accent"
          >
            {note}
          </a>
        ) : noteDatetime ? (
          <time
            datetime={isoDate(noteDatetime)}
            data-relative={notePrefix}
            class="inline-block tracking-[0.02em]"
          >
            {note}
          </time>
        ) : (
          <span class="inline-block tracking-[0.02em]">{note}</span>
        ))
    }
  </div>

  <div class="column measure-row"><slot /></div>
</section>
