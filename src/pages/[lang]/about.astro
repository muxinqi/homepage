---
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import MetaTable, { type MetaRow } from "@components/MetaTable.astro";
import avatar from "@assets/avatar.jpg";
import { localeParams, type Locale } from "@i18n/locales";
import { useTranslations } from "@i18n/ui";

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const copy = {
  en: {
    description: "About Xinqi Mu — what he builds, and how to reach him.",
    where: ["Where", "Ottawa, Canada"],
    email: "Email",
    elsewhere: "Elsewhere",
  },
  zh: {
    description: "关于 Xinqi Mu：做些什么，以及怎么联系。",
    where: ["所在地", "加拿大 渥太华"],
    email: "邮箱",
    elsewhere: "其他地方",
  },
}[lang];

const rows: MetaRow[] = [
  { label: copy.where[0], value: copy.where[1] },
  // Not obfuscated. The address is already in this repository's public commit
  // metadata, so hiding it here would only cost a human reader the next step.
  {
    label: copy.email,
    links: [{ label: "hi@muxinqi.com", href: "mailto:hi@muxinqi.com" }],
  },
  {
    label: copy.elsewhere,
    links: [
      { label: "github", href: "https://github.com/muxinqi", external: true },
      { label: "linkedin", href: "https://linkedin.com/in/muxinqi", external: true },
    ],
  },
];
---

<BaseLayout {lang} title={t("about")} description={copy.description}>
  <div class="rail-row pt-[clamp(2rem,9vw,3.25rem)]">
    <div class="rail">
      {/* The only rounded corner on the site. */}
      <Image
        src={avatar}
        alt=""
        width={64}
        height={64}
        densities={[1, 2]}
        loading="eager"
        class="size-16 rounded-full border border-line"
      />
    </div>

    <div class="column">
      <h1 class="font-display text-h1 text-ink">{t("about")}</h1>

      {/* Prose stays here, one block per language, because its links sit inside
          the sentences — a dictionary would cut every paragraph into pieces. */}
      <div class="prose mt-5">
        {
          lang === "zh" ? (
            <>
              <p>
                我是 Xinqi Mu。我写实用的软件，网页、手机都做，也会顺手把一些我嫌麻烦的小事变简单。我喜欢那种用过之后就觉得理所当然的工具。
              </p>
              <p>
                这个网站放着我做过的东西，以及做的时候想记住的事。它首先是写给以后的自己看的，所以项目旁边的状态只说它还能不能用，不说做得怎么样。
              </p>
              <p>
                我也做饭。这里有一份<a href="https://menu.xinqi.mu">菜单</a>，都是我愿意做给你吃的菜。
              </p>
            </>
          ) : (
            <>
              <p>
                I'm Xinqi Mu. I build useful software for the web, mobile, and the occasional
                thing I wanted to make simpler. I like tools that feel obvious after you use
                them.
              </p>
              <p>
                This site holds what I've made and what I want to remember about making it.
                It's written first for a later version of me, which is why the status next to
                a project says whether it still works rather than how it went.
              </p>
              <p>
                I cook, too. Here's a <a href="https://menu.xinqi.mu">menu</a> of the dishes
                I'd make for you.
              </p>
            </>
          )
        }
      </div>

      <MetaTable {rows} class="mt-[22px]" />
    </div>
  </div>
</BaseLayout>
