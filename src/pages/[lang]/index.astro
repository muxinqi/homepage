---
import BaseLayout from "@layouts/BaseLayout.astro";
import RailSection from "@components/RailSection.astro";
import ProjectRow from "@components/ProjectRow.astro";
import NoteRow from "@components/NoteRow.astro";
import EmptyState from "@components/EmptyState.astro";
import { getNotes, getNow, getProjects } from "@lib/content";
import { monthYear } from "@lib/date";
import { localeParams, localePath, type Locale } from "@i18n/locales";
import { useTranslations } from "@i18n/ui";

export const getStaticPaths = localeParams;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const copy = {
  en: {
    description:
      "Xinqi Mu builds useful software for the web, mobile, and the occasional thing he wanted to make simpler.",
    lede: "I build useful software for the web, mobile, and the occasional thing I wanted to make simpler. Based in Ottawa.",
  },
  zh: {
    description: "Xinqi Mu 写实用的软件，网页、手机都做，也会顺手把一些嫌麻烦的小事变简单。",
    lede: "我写实用的软件，网页、手机都做，也会顺手把一些我嫌麻烦的小事变简单。现居渥太华。",
  },
}[lang];

const allProjects = await getProjects(lang);
const featured = allProjects.filter((p) => p.data.featured);
const projects = (featured.length > 0 ? featured : allProjects).slice(0, 3);

const notes = (await getNotes(lang)).slice(0, 2);
const now = await getNow(lang);
---

<BaseLayout {lang} description={copy.description}>
  <div class="pt-[clamp(2rem,9vw,3.25rem)]">
    <h1 class="font-display text-name text-ink">Xinqi Mu</h1>
    <p class="mt-3.5 max-w-[46ch] text-lede text-ink-soft text-pretty">{copy.lede}</p>
  </div>

  <RailSection
    label={t("projects")}
    id="projects"
    note={t("all")}
    noteHref={localePath(lang, "/projects/")}
    noteLabel={t("allProjects")}
    class="pt-10"
  >
    {
      projects.length > 0 ? (
        <div class="row-list border-t border-line">
          {projects.map((project) => (
            <ProjectRow {project} showLinks={false} />
          ))}
        </div>
      ) : (
        <EmptyState section="projects" {lang} />
      )
    }
  </RailSection>

  {/* The whole section waits for its first note, the way Now waits for its
      file. An empty box on the homepage advertises a room with nothing in it. */}
  {
    notes.length > 0 && (
      <RailSection
        label={t("notes")}
        id="notes"
        note={t("all")}
        noteHref={localePath(lang, "/notes/")}
        noteLabel={t("allNotes")}
        class="pt-8"
      >
        <div class="row-list border-t border-line">
          {notes.map((note) => (
            <NoteRow {note} dateFormat="monthYear" />
          ))}
        </div>
      </RailSection>
    )
  }

  {
    now && (
      <RailSection
        label={t("now")}
        id="now"
        note={`${t("updated")} ${monthYear(now.data.updated, lang)}`}
        noteDatetime={now.data.updated}
        notePrefix={t("updated")}
        alignToList={false}
        class="pt-8"
      >
        <dl class="row-list">
          {now.data.items.slice(0, 2).map((item) => (
            <div class="row pb-[11px]">
              <dt class="pt-[5px] font-mono text-rail tracking-[0.1em] text-ink-muted uppercase">
                {item.label}
              </dt>
              <dd class="max-w-[54ch] min-w-0 text-item text-pretty">{item.text}</dd>
            </div>
          ))}
        </dl>
      </RailSection>
    )
  }

  {/* Inside the layout on purpose. BaseLayout renders the whole document, so a
      script placed after </BaseLayout> lands after </html> — which browsers
      recover from and strict parsers do not. */}
  <script>
  // "Updated 2 months ago" rather than "Updated Aug 2026". A static build cannot
  // say this — it would freeze at deploy time — so it is the one thing here that
  // genuinely belongs at runtime.
  //
  // Intl.RelativeTimeFormat is built in (2018), so this costs no dependency. The
  // server already rendered the absolute month; if anything below fails, that is
  // what stays on screen, and it is never wrong — only less pointed.
  const DIVISIONS = [
    [60, "second"],
    [60, "minute"],
    [24, "hour"],
    [7, "day"],
    [4.34524, "week"],
    [12, "month"],
    [Number.POSITIVE_INFINITY, "year"],
  ] as const;

  try {
    const rtf = new Intl.RelativeTimeFormat(document.documentElement.lang || "en", {
      numeric: "auto",
    });

    for (const el of document.querySelectorAll<HTMLTimeElement>("[data-relative]")) {
      const then = new Date(el.dateTime);
      if (Number.isNaN(then.valueOf())) continue;

      // Never positive. `datetime` is a bare date, which parses as UTC midnight,
      // so a reader east of UTC sees today's date as an hour or ten in their own
      // future — and "Updated in 9 hours" is worse than no rewrite at all. A
      // clamped delta formats as "now", which is what the reader means by it.
      let delta = Math.min(0, (then.valueOf() - Date.now()) / 1000);
      for (const [amount, unit] of DIVISIONS) {
        if (Math.abs(delta) < amount) {
          const prefix = el.dataset.relative;
          el.textContent = (prefix ? prefix + " " : "") + rtf.format(Math.round(delta), unit);
          break;
        }
        delta /= amount;
      }
    }
  } catch {
    // No Intl.RelativeTimeFormat. The absolute month is already on screen.
  }
  </script>
</BaseLayout>
