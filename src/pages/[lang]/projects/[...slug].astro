---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import StatusMark from "@components/StatusMark.astro";
import MetaTable, { type MetaRow } from "@components/MetaTable.astro";
import { getProjects, statusText, type Project } from "@lib/content";
import { monthYear } from "@lib/date";
import { locales, localePath } from "@i18n/locales";
import { useTranslations } from "@i18n/ui";

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await Promise.all(
    locales.map(async (lang) =>
      (await getProjects(lang)).map((project) => ({
        params: { lang, slug: project.slug },
        props: { project },
      })),
    ),
  );
  return pages.flat();
};

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { lang } = project;
const t = useTranslations(lang);
const { label: statusLabel, meaning: statusMeaning } = statusText(project.data.status, lang);
const { title, summary, status, created, updated, closed, url, repo, stack } =
  project.data;
const { Content } = await render(project);
// A project with only a summary and a metadata table is a complete page. Better
// an honest short one than a padded long one.
const hasBody = Boolean(project.body?.trim());

const built =
  updated && monthYear(updated, lang) !== monthYear(created, lang)
    ? `${monthYear(created, lang)} – ${monthYear(updated, lang)}`
    : monthYear(created, lang);

const links = [
  url && { label: new URL(url).host, href: url, external: true },
  repo && { label: t("source"), href: repo, external: true },
].filter((link): link is { label: string; href: string; external: boolean } =>
  Boolean(link),
);

const rows: MetaRow[] = [
  { label: t("status"), value: `${statusLabel} — ${statusMeaning}` },
  { label: t("built"), value: built },
  // Only meaningful for an offline project; the list row already gates on the
  // same pair, and without this an Active badge could sit above a Closed date.
  ...(status === "offline" && closed
    ? [{ label: t("closed"), value: monthYear(closed, lang) }]
    : []),
  ...(stack ? [{ label: t("stack"), value: stack }] : []),
  ...(links.length > 0 ? [{ label: t("links"), links }] : []),
];
---

<BaseLayout {lang} title={title} description={summary} ogType="article">
  <div class="rail-row pt-[clamp(2rem,9vw,3.25rem)]">
    <div class="rail"><StatusMark {status} {lang} alignToTitle /></div>

    <div class="column">
      <h1 class="font-display text-h1 text-ink">{title}</h1>
      <p class="mt-[9px] max-w-[48ch] text-intro text-ink-soft text-pretty">
        {summary}
      </p>

      <MetaTable {rows} class="mt-[22px]" />

      {hasBody && <div class="prose mt-[26px]"><Content /></div>}

      <div class="mt-[26px] border-t border-line pt-[13px] font-mono text-meta text-accent">
        <a href={localePath(lang, "/projects/")} class="meta-link">{t("backToProjects")}</a>
      </div>
    </div>
  </div>
</BaseLayout>
