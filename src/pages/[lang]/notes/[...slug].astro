---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getNotes, type Note } from "@lib/content";
import { isoDate, monthYear } from "@lib/date";
import { locales, localePath } from "@i18n/locales";
import { useTranslations } from "@i18n/ui";

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await Promise.all(
    locales.map(async (lang) =>
      (await getNotes(lang)).map((note) => ({
        params: { lang, slug: note.slug },
        props: { note },
      })),
    ),
  );
  return pages.flat();
};

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { lang } = note;
const t = useTranslations(lang);
const { title, summary, created, updated } = note.data;
const { Content } = await render(note);
// Same guard as the project page: an empty `.prose` still carries its margin,
// so a note that is only a title would open a gap where the text should be.
const hasBody = Boolean(note.body?.trim());

// The rail carries the date and nothing else. The page ends by going back to the
// list — no "next post", no recommendations.
---

<BaseLayout {lang} {title} description={summary ?? title} ogType="article">
  <div class="rail-row pt-[clamp(2rem,9vw,3.25rem)]">
    <div class="rail">
      <time
        datetime={isoDate(created)}
        class="block pt-[9px] font-mono text-rail tracking-label text-ink-muted uppercase"
        >{monthYear(created, lang)}</time
      >
      {
        updated && monthYear(updated, lang) !== monthYear(created, lang) && (
          <time
            datetime={isoDate(updated)}
            class="block font-mono text-rail tracking-[0.02em] text-ink-muted"
          >
            {t("revised")} {monthYear(updated, lang)}
          </time>
        )
      }
    </div>

    <div class="column">
      <h1 class="max-w-[34ch] font-display text-h1 text-ink">{title}</h1>

      {hasBody && <div class="prose mt-[22px]"><Content /></div>}

      <div class="mt-[26px] border-t border-line pt-[13px] font-mono text-meta text-accent">
        <a href={localePath(lang, "/notes/")} class="meta-link">{t("backToNotes")}</a>
      </div>
    </div>
  </div>
</BaseLayout>
