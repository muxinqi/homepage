---
import BaseLayout from "@layouts/BaseLayout.astro";
import NoteRow from "@components/NoteRow.astro";
import EmptyState from "@components/EmptyState.astro";
import { getNotes, groupByYear } from "@lib/content";

const groups = groupByYear(await getNotes());

const description =
  "Short pieces by Xinqi Mu on the decisions behind the things he builds. No schedule.";
---

<BaseLayout title="Notes" {description}>
  <h1 class="mt-[clamp(2rem,9vw,3.25rem)] mb-2 font-display text-h1 text-ink">Notes</h1>
  <p class="mb-[34px] max-w-[48ch] text-intro text-ink-soft text-pretty">
    Short pieces on the decisions behind the things I build. No schedule.
  </p>

  {
    groups.length > 0 ? (
      groups.map(({ year, rows }) => (
        <div class="rail-row pb-6">
          <div class="rail bg-ground pt-[15px] font-mono text-meta font-medium tracking-[0.06em] text-ink max-sm:sticky max-sm:top-0 max-sm:z-2">
            {year}
          </div>
          <div class="column measure-row row-list border-t border-line">
            {rows.map((note) => (
              <NoteRow {note} />
            ))}
          </div>
        </div>
      ))
    ) : (
      <EmptyState
        title="Nothing here yet"
        detail="The first one will show up here, and in the feed."
      />
    )
  }
</BaseLayout>
