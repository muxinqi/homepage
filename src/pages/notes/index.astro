---
import BaseLayout from "@layouts/BaseLayout.astro";
import NoteRow from "@components/NoteRow.astro";
import EmptyState from "@components/EmptyState.astro";
import { getNotes, groupByYear } from "@lib/content";

const groups = groupByYear(await getNotes());

const description =
  "Short pieces by Xinqi Mu on the decisions behind the things he builds. No schedule.";

// Nothing links here while the section is empty, so the only way in is a search
// result — and an empty page is a bad one. The route still answers, for anyone
// holding the URL.
const empty = groups.length === 0;
---

<BaseLayout title="Notes" {description} noindex={empty}>
  <h1 class="mt-[clamp(2rem,9vw,3.25rem)] mb-2 font-display text-h1 text-ink">Notes</h1>
  <p class="mb-[34px] max-w-[48ch] text-intro text-ink-soft text-pretty">
    Short pieces on the decisions behind the things I build. No schedule.
  </p>

  {
    groups.length > 0 ? (
      groups.map(({ year, rows }) => (
        <div class="rail-row pb-6">
          <div class="rail-year pt-[15px] font-mono text-meta font-medium tracking-[0.06em] text-ink">
            {year}
          </div>
          <div class="column measure-row row-list border-t border-line">
            {rows.map((note) => (
              <NoteRow {note} />
            ))}
          </div>
        </div>
      ))
    ) : (
      <EmptyState section="notes" />
    )
  }
</BaseLayout>
