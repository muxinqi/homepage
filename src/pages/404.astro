---
import BaseLayout from "@layouts/BaseLayout.astro";

const description = "That page doesn't exist.";
---

<BaseLayout title="Not here" {description} noindex>
  <div class="rail-row pt-[clamp(2rem,9vw,3.25rem)]">
    <div class="rail pt-[9px] font-mono text-rail tracking-[0.1em] text-ink-muted uppercase">
      404
    </div>

    <div class="column">
      <h1 class="font-display text-h1 text-ink">Not here</h1>
      <p class="mt-[9px] max-w-[48ch] text-intro text-ink-soft text-pretty">
        This URL doesn't exist, or it did and I moved it without leaving a redirect. Both
        are my fault.
      </p>

      <nav
        aria-label="Ways out"
        class="mt-[22px] flex flex-wrap gap-x-4 gap-y-2 font-mono text-meta text-accent uppercase"
      >
        <a href="/projects/" class="meta-link">Projects →</a>
        <a href="/notes/" class="meta-link">Notes →</a>
        <a href="/" class="meta-link">Home →</a>
      </nav>
    </div>
  </div>
</BaseLayout>
