---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="这个地址上没有东西。">
  <div class="flex flex-col items-start gap-6 py-8">
    <img
      src="/images/avatar.jpg"
      alt=""
      width="96"
      height="96"
      class="h-24 w-24 rounded-full border border-line"
    />
    <div class="flex flex-col gap-3">
      <h1 class="text-2xl font-semibold tracking-tight">这里没有东西</h1>
      <p class="max-w-md leading-relaxed text-muted">
        这个地址上没有页面。可能是我把它挪走了，也可能它从来就不存在。
      </p>
    </div>
    <ul class="flex flex-wrap gap-5 text-sm">
      <li><a href="/" class="text-accent underline underline-offset-2">回首页</a></li>
      <li><a href="/projects/" class="text-accent underline underline-offset-2">看项目</a></li>
      <li><a href="/posts/" class="text-accent underline underline-offset-2">看文章</a></li>
    </ul>
  </div>
</BaseLayout>
