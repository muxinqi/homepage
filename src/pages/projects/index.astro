---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectRow from "@components/ProjectRow.astro";
import EmptyState from "@components/EmptyState.astro";
import { getProjects, groupByYear } from "@lib/content";

const groups = groupByYear(await getProjects());

const description =
  "Small tools Xinqi Mu built because he wanted to use them, and whether each one still works.";
---

<BaseLayout title="Projects" {description}>
  <h1 class="mt-[clamp(2rem,9vw,3.25rem)] mb-2 font-display text-h1 text-ink">Projects</h1>
  <p class="mb-[34px] max-w-[48ch] text-intro text-ink-soft text-pretty">
    Small tools I built because I wanted to use them. The status says whether you can use
    it today.
  </p>

  {
    groups.length > 0 ? (
      groups.map(({ year, rows }) => (
        <div class="rail-row pb-6">
          <div class="rail-year pt-[15px] font-mono text-meta font-medium tracking-[0.06em] text-ink">
            {year}
          </div>
          <div class="column measure-row row-list border-t border-line">
            {rows.map((project) => (
              <ProjectRow {project} dateFormat="updated" />
            ))}
          </div>
        </div>
      ))
    ) : (
      <EmptyState
        title="Nothing here yet"
        detail="The first one will show up here, with what it does and whether it still works."
      />
    )
  }
</BaseLayout>
