{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "homepage",
	"compatibility_date": "2026-06-23",
	"assets": {
		"directory": "./dist",
		// The default, written down because the site depends on it. Every page
		// is built as a folder with an index.html, so /about answers with a
		// redirect to /about/ — the form every link, canonical tag and sitemap
		// entry uses. Cloudflare sends that redirect as a 307, and nothing here
		// can change the code; the canonical tags are what search engines keep.
		"html_handling": "auto-trailing-slash",
		// Without this, an unknown path returns a bare 404 and the designed
		// 404 page is never reached.
		"not_found_handling": "404-page"
	},
	// The site answers on its custom domain. Without this a full second copy
	// is also live at homepage.<subdomain>.workers.dev, indexable and serving a
	// robots.txt that says Allow: /.
	"workers_dev": false,
	// Preview URLs (<version>-homepage.<subdomain>.workers.dev) are what put a
	// link on each pull request. Left unset they follow workers_dev and stay
	// off. They are public, so public/_headers sends X-Robots-Tag: noindex for
	// every workers.dev host; the custom domain never matches that rule.
	// Only `wrangler deploy` (main) writes this setting to Cloudflare; the
	// `versions upload` that branch builds run just reads it.
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
