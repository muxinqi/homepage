# Parsed by Cloudflare Workers static assets; the file itself is never served.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Preview URLs for pull requests live on workers.dev and are public. They must
# never be indexed; robots.txt says Allow: / on every host, so the header does it.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Filenames here carry a content hash, so a change is a new URL and the old one
# can be cached indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
