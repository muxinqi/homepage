# Parsed by Cloudflare Workers static assets; the file itself is never served.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Filenames here carry a content hash, so a change is a new URL and the old one
# can be cached indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# A static build discards the Response headers set in the route, so the feed
# would otherwise go out as application/xml. Feed readers poll it, so let them
# revalidate rather than serve a stale copy.
/notes/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
